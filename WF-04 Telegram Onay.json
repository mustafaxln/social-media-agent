      "parameters": {
        "jsCode": "const item = $input.first();\nconst binary = item.binary?.data;\n\nif (!binary) {\n  throw new Error('Binary data bulunamadi');\n}\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst base64 = Buffer.from(buffer).toString('base64');\n\nreturn [{\n  json: {\n    ...item.json,\n    image_base64: base64,\n    content_id: $('Callback Parse').first().json.content_id\n  }\n}];"
