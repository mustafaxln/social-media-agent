    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nconst cq = raw.callbackQuery || raw.callback_query || raw;\nconst data = cq.data || raw.data || '';\nconst parts = String(data).split(':');\nconst actionRaw = (parts[0] || '').trim();\nconst contentId = (parts[1] || '').trim();\n\nconst action =\n  actionRaw === 'approve' ? 'approved' :\n  actionRaw === 'reject' ? 'rejected' :\n  actionRaw === 'publish' ? 'publish' :\n  actionRaw === 'cancel' ? 'cancel' :\n  'unknown';\n\nreturn [{\n  json: {\n    action,\n    content_id: contentId,\n    callback_query_id: String(cq.id || raw.id || ''),\n    chat_id: cq.message?.chat?.id || raw.message?.chat?.id || '',\n    message_id: cq.message?.message_id || ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        32
      ],
