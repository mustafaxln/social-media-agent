    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst LINKEDIN_CHANNEL_ID = '6a6081ace2638b94d7b2a36b';\nconst INSTAGRAM_CHANNEL_ID = '6a608040e2638b94d7b29f29';\n\nconst hashtags = Array.isArray(d.hashtags)\n  ? d.hashtags.join(' ')\n  : String(d.hashtags || '');\n\nconst postText = `${d.content || ''}\\n\\n${hashtags}`.trim();\n\nconst platform = String(d.platform || '').toLowerCase();\nconst isInstagram = platform.includes('instagram');\nconst channelId = isInstagram ? INSTAGRAM_CHANNEL_ID : LINKEDIN_CHANNEL_ID;\n\nif (!d.image_url) {\n  throw new Error('image_url bos');\n}\n\n// Instagram zorunlu metadata; LinkedIn'de metadata yok\nconst metadataBlock = isInstagram\n  ? `\n      metadata: {\n        instagram: {\n          type: post\n          shouldShareToFeed: true\n        }\n      }`\n  : '';\n\nconst query = `\nmutation CreatePost {\n  createPost(\n    input: {\n      text: ${JSON.stringify(postText)}\n      channelId: ${JSON.stringify(channelId)}\n      schedulingType: automatic\n      mode: shareNow\n      ${metadataBlock}\n      assets: [{ image: { url: ${JSON.stringify(d.image_url)} } }]\n    }\n  ) {\n    ... on PostActionSuccess { post { id text } }\n    ... on MutationError { message }\n  }\n}`;\n\nreturn [{\n  json: {\n    query,\n    content_id: String(d.id || $('Callback Parse').first().json.content_id),\n    platform: d.platform,\n    channelId,\n    isInstagram\n  }\n}];"
      },
