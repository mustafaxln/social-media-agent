    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nconst workflow_name = raw.workflow?.name || String(raw.workflow || 'unknown');\nconst execution_id = String(raw.execution?.id ?? '');\n\nconst node_name =\n  raw.execution?.lastNodeExecuted ||\n  raw.node?.name ||\n  raw.trigger?.error?.node?.name ||\n  '';\n\nlet error_message =\n  raw.execution?.error?.message ||\n  raw.execution?.error?.description ||\n  raw.error?.message ||\n  raw.trigger?.error?.message ||\n  '';\n\nif (!error_message && raw.execution?.error) {\n  error_message =\n    typeof raw.execution.error === 'string'\n      ? raw.execution.error\n      : JSON.stringify(raw.execution.error);\n}\n\nif (!error_message) {\n  error_message = JSON.stringify(raw);\n}\n\nconst created_at = new Date().toISOString();\n\nconst telegram_message = `Sosyal Medya Agent — HATA\n\nWorkflow: ${workflow_name}\nExecution: ${execution_id}\nNode: ${node_name || '-'}\n\nHata:\n${error_message}\n\nZaman: ${created_at}`;\n\nreturn [{\n  json: {\n    workflow_name,\n    execution_id,\n    node_name,\n    error_message,\n    created_at,\n    telegram_message\n  }\n}];"
      },
