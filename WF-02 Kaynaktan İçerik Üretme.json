    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst d = item.output || item;\n\nconst source = $('Limit').first().json;\n\nconst hashtags = Array.isArray(d.hashtags)\n  ? d.hashtags\n      .map((tag) => String(tag).trim().replace(/-/g, ''))\n      .join(' ')\n  : String(d.hashtags || '').replace(/#/g, ' #').replace(/-/g, '');\n\nconst message = `Yeni Sosyal Medya Icerik Taslagi\n\nPlatform: ${d.platform || ''}\nKategori: ${d.category || ''}\nHedef Kitle: ${d.target_audience || ''}\nEtki Skoru: ${d.impact_score || ''}/5\n\nKaynak: ${source.source_name || ''} — ${source.url || ''}\n\nBaslik:\n${d.title || ''}\n\nIcerik:\n${d.content || ''}\n\nHashtagler:\n${hashtags}\n\nGorsel Fikri:\n${d.visual_idea || ''}\n\nCTA:\n${d.cta || ''}\n\nDurum: Onay bekliyor`;\n\nreturn [{\n  json: {\n    ...d,\n    source_url: source.url || '',\n    telegram_message: message\n  }\n}];"
      },
